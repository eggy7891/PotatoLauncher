<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="PotatoLauncher 1.0.2"
           Manufacturer="PotatoLauncher contributors"
           Version="1.0.2.0"
           UpgradeCode="8ec1ded4-6b79-4c98-8b8c-f7d98a9e8c22"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="PotatoLauncher - Material Design 3 Minecraft Launcher" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 PotatoLauncher。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PotatoLauncher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="PotatoLauncher" />
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="PotatoLauncher" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut"
                  Name="PotatoLauncher"
                  Description="Material Design 3 Minecraft 启动器"
                  Target="[INSTALLFOLDER]PotatoLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PotatoLauncher"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="PublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="..\artifacts\publish\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
