<Window x:Class="PotatoLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:PotatoLauncher.App.Views"
        Title="PotatoLauncher"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="P" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentBrush}" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PotatoLauncher" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TextButton}" Padding="14,8" Width="46" Height="38"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"
                            ToolTip="最小化">
                        <Path Data="M5 12h14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource TextButton}" Padding="14,8" Width="46" Height="38"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"
                            ToolTip="最大化或还原">
                        <Path Data="M5 5h14v14H5z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource TextButton}" Padding="14,8" Width="46" Height="38"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"
                            ToolTip="关闭">
                        <Path Data="M6 6l12 12M18 6L6 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="0" Margin="12,4,0,12" CornerRadius="26"
                    Background="{DynamicResource SurfaceContainerBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Margin="18,20,18,18" Padding="14" CornerRadius="18"
                            Background="{DynamicResource SurfaceContainerHighBrush}">
                        <StackPanel>
                            <TextBlock Text="当前账号" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding SelectedAccountName}" FontWeight="SemiBold" Margin="0,5,0,1" />
                            <TextBlock Text="{Binding SelectedAccountKind}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Navigation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon}" Width="19" Height="19" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <TextBlock Text="{Binding Label}" Margin="13,0,0,0" FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="2" Margin="16" Padding="14" CornerRadius="18"
                            Background="{DynamicResource SurfaceContainerHighBrush}">
                        <StackPanel>
                            <TextBlock Text="本机 Java" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding SelectedJava.VersionText, FallbackValue=未检测到}"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="12,4,12,12">
                <views:HomePage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=home}" />
                <views:InstancesPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=instances}" />
                <views:DownloadsPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=downloads}" />
                <views:AccountsPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=accounts}" />
                <views:TasksPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=tasks}" />
                <views:SettingsPage Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=settings}" />
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceContainerBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ProgressBar Width="180" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Margin="0,0,12,0" />
                    <Button Content="日志" Style="{StaticResource TextButton}" FontSize="11"
                            Command="{Binding ToggleLogPanelCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Width="430"
                    Margin="0,10,20,18" CornerRadius="24" Background="#F2241E17"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    Visibility="{Binding ShowLogPanel, Converter={StaticResource BoolToVisibility}}"
                    Panel.ZIndex="20">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="实时日志" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="清空" Style="{StaticResource TextButton}" Command="{Binding ClearVisibleLogCommand}" />
                            <Button Content="关闭" Style="{StaticResource TextButton}" Command="{Binding ToggleLogPanelCommand}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Logs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
