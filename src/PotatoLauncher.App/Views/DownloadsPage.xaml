<UserControl x:Class="PotatoLauncher.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,28">
            <StackPanel Margin="6,0,6,20">
                <TextBlock Text="下载中心" Style="{StaticResource PageTitle}" />
                <TextBlock Text="官方源优先，失败时由你决定是否切换镜像。" Style="{StaticResource MutedText}" FontSize="14" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Minecraft 原版" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="从 Mojang 清单安装客户端、支持库和资源。" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <CheckBox Content="显示快照" IsChecked="{Binding IncludeSnapshots}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding VanillaVersions}" SelectedItem="{Binding SelectedVanillaVersion}"
                                  DisplayMemberPath="Id" MaxDropDownHeight="300" />
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource OutlineButton}" Margin="10,0,0,0"
                                Command="{Binding LoadVanillaVersionsCommand}" />
                    </Grid>
                    <Button Content="安装所选版本" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Command="{Binding InstallVanillaCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="模组加载器" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Fabric 与 Quilt 使用官方 meta；Forge 与 NeoForge 运行官方安装器。" Style="{StaticResource MutedText}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding LoaderKinds}" SelectedItem="{Binding SelectedLoader}" />
                        <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding LoaderGameVersion, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Minecraft 版本，例如 1.20.1" />
                        <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding LoaderVersions}"
                                  SelectedItem="{Binding SelectedLoaderVersion}" />
                        <Button Grid.Column="3" Content="获取版本" Style="{StaticResource OutlineButton}" Margin="10,0,0,0"
                                Command="{Binding LoadLoaderVersionsCommand}" />
                    </Grid>
                    <Button Content="安装加载器实例" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Command="{Binding InstallLoaderCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Modrinth 社区内容" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索关键词，留空可浏览热门项目" />
                        <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding ProjectTypes}"
                                  SelectedItem="{Binding SearchProjectType}" />
                        <TextBox Grid.Column="2" Margin="10,0,0,0" Text="{Binding SearchGameVersion}"
                                 ToolTip="Minecraft 版本" />
                        <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding SearchLoaders}"
                                  SelectedItem="{Binding SearchLoader}" />
                        <Button Grid.Column="4" Content="搜索" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Command="{Binding SearchModrinthCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedProject}"
                             MaxHeight="360" Margin="0,14,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="13"
                                            Background="{DynamicResource SurfaceContainerHighestBrush}">
                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" ClipToBounds="True" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="620" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="安装" Style="{StaticResource TonalButton}"
                                            Padding="16,8" MinHeight="34"
                                            Command="{Binding DataContext.InstallProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
