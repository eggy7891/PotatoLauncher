<UserControl x:Class="PotatoLauncher.App.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <UserControl.Resources>
        <Style x:Key="DownloadTabButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background"
                                        Value="{DynamicResource SurfaceContainerHighestBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentContainerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,20,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="6,0,6,16">
            <StackPanel>
                <TextBlock Text="下载中心" Style="{StaticResource PageTitle}" />
                <TextBlock Text="进入页面自动刷新；资源按下载量从高到低显示。"
                           Style="{StaticResource MutedText}" FontSize="14" />
            </StackPanel>
            <Button Content="刷新当前页"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding SelectDownloadSectionCommand}"
                    CommandParameter="{Binding SelectedDownloadSection}" />
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding DownloadSections}" Margin="6,0,6,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DownloadTabButton}"
                            Content="{Binding Label}"
                            Command="{Binding DataContext.SelectDownloadSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Key}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{Binding IsVanillaSection, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="0.85*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="6,0,6,12">
                                <TextBlock Text="全部 Minecraft 版本" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="{Binding VanillaVersions.Count, StringFormat={}{0} 个版本}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding VanillaVersions}"
                                     SelectedItem="{Binding SelectedVanillaVersion}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ReleaseTime, StringFormat={}{0:yyyy-MM-dd}}"
                                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Type}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="安装"
                                                    Style="{StaticResource TonalButton}"
                                                    Padding="18,7" MinHeight="34"
                                                    Command="{Binding DataContext.InstallVanillaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="安装加载器" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选择游戏版本、加载器并安装官方版本。"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="游戏版本" Style="{StaticResource MutedText}" Margin="0,14,0,7" />
                                <ComboBox ItemsSource="{Binding GameVersionChoices}"
                                          SelectedItem="{Binding LoaderGameVersion}" />
                                <TextBlock Text="加载器" Style="{StaticResource MutedText}" Margin="0,12,0,7" />
                                <ComboBox ItemsSource="{Binding LoaderKinds}"
                                          SelectedItem="{Binding SelectedLoader}" />
                                <Button Content="获取可用加载器版本"
                                        Style="{StaticResource OutlineButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Command="{Binding LoadLoaderVersionsCommand}" />
                                <ComboBox ItemsSource="{Binding LoaderVersions}"
                                          SelectedItem="{Binding SelectedLoaderVersion}"
                                          Margin="0,10,0,0" />
                                <Button Content="安装加载器实例"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Command="{Binding InstallLoaderCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="下载源" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="资源由 Modrinth 官方 API 按下载量自动加载，无需登录或 API Key。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Visibility="{Binding IsCatalogListVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding CatalogStatus}"
                           Style="{StaticResource MutedText}"
                           Margin="6,0,6,10" />
                <ListBox Grid.Row="1" ItemsSource="{Binding CatalogProjects}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProjectCardButton}"
                                    Command="{Binding DataContext.OpenCatalogProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border Background="{DynamicResource SurfaceContainerBrush}"
                                        BorderBrush="{DynamicResource SurfaceContainerHighestBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="13"
                                                Background="{DynamicResource SurfaceContainerHighestBrush}">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" ClipToBounds="True" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="640" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DownloadsLabel}"
                                                       Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ScrollViewer Visibility="{Binding IsProjectDetailVisible, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Button Content="← 返回项目列表"
                            Style="{StaticResource TextButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding CloseCatalogProjectCommand}" />
                    <Border Style="{StaticResource Card}" Margin="0,10,0,16" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" CornerRadius="22"
                                    Background="{DynamicResource SurfaceContainerHighestBrush}">
                                <Image Source="{Binding SelectedCatalogProject.IconUrl}"
                                       Stretch="UniformToFill" ClipToBounds="True" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,18,0">
                                <TextBlock Text="{Binding SelectedCatalogProject.Title}"
                                           FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedCatalogProject.Description}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedCatalogProject.SourceLabel}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SelectedCatalogProject.DownloadsLabel}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" />
                                <Button Content="打开项目网页"
                                        Style="{StaticResource OutlineButton}"
                                        Margin="0,10,0,0"
                                        Click="OpenProjectPage_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="游戏版本" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding ProjectGameVersions}"
                                          SelectedItem="{Binding SelectedProjectGameVersion}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding ShowCatalogLoaderFilter, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="加载器" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding ProjectLoaders}"
                                          SelectedItem="{Binding SelectedProjectLoader}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="官方文件版本" Style="{StaticResource SectionTitle}" Margin="6,0,6,10" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredProjectVersions}"
                                         SelectedItem="{Binding SelectedCatalogVersion}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding GameVersionsLabel}"
                                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding LoadersLabel}"
                                                           Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="下载到本地实例"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding CatalogStatus}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <ListBox ItemsSource="{Binding MatchingDownloadInstances}"
                                         SelectedItem="{Binding SelectedDownloadInstance}"
                                         MaxHeight="260">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding LoaderLabel}"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding GameVersion}"
                                                           Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="下载所选官方版本"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,14,0,0"
                                        Command="{Binding DownloadCatalogVersionCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
