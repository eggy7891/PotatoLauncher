<UserControl x:Class="PotatoLauncher.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,30">
            <Grid Margin="6,0,6,22">
                <StackPanel>
                    <TextBlock Text="开始游戏" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="为你的 Minecraft 世界准备就绪。" Style="{StaticResource MutedText}" FontSize="14" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" CornerRadius="16"
                        Background="{DynamicResource SurfaceContainerBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SelectedAccountName}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="76" Height="76" CornerRadius="24"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentContainerBrush}">
                            <Path Data="M7 4h10v3H7zm0 6h10v3H7zm0 6h6v3H7z"
                                  Stroke="{DynamicResource OnAccentContainerBrush}"
                                  StrokeThickness="1.6" Stretch="Uniform" Width="30" Height="30" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,25,0,22">
                            <TextBlock Text="{Binding SelectedInstance.DisplayName, FallbackValue=选择或安装一个实例}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedInstanceSummary}" FontSize="15"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SelectedInstance.DirectoryPath}"
                                       FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前 Java" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedJava.VersionText, FallbackValue=未检测到}"
                                           FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="启动游戏" Style="{StaticResource PrimaryButton}"
                                    MinWidth="150" Height="52" FontSize="16"
                                    Command="{Binding LaunchCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="实例总览" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Instances.Count, StringFormat={}{0} 个本地实例}"
                                       FontSize="25" FontWeight="SemiBold" />
                            <TextBlock Text="包含原版、Fabric、Forge 与 NeoForge"
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            <Button Content="管理实例" Style="{StaticResource OutlineButton}" Margin="0,18,0,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="instances" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="下载中心" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="安装游戏、加载器与社区内容" Style="{StaticResource MutedText}" />
                            <Button Content="打开下载" Style="{StaticResource TonalButton}" Margin="0,18,0,0"
                                    Command="{Binding NavigateCommand}" CommandParameter="downloads" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="最近实例" Style="{StaticResource SectionTitle}" Margin="6,26,0,10" />
            <ListBox ItemsSource="{Binding Instances}" MaxHeight="250">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="20" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding GameVersion, FallbackValue=未知}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
