<UserControl x:Class="PotatoLauncher.App.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <Grid Margin="16,24,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="6,0,6,18">
            <StackPanel>
                <TextBlock Text="实例" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Settings.MinecraftDirectory}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="选择目录" Style="{StaticResource OutlineButton}" Command="{Binding ChooseMinecraftFolderCommand}" />
                <Button Content="重新扫描" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding RefreshInstancesCommand}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="12"
                                        Background="{DynamicResource SurfaceContainerHighestBrush}">
                                    <TextBlock Text="{Binding LoaderLabel}" FontSize="9" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding GameVersion, FallbackValue=未知}"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedInstance.DisplayName, FallbackValue=未选择实例}"
                               FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedInstanceSummary}" Style="{StaticResource MutedText}"
                               FontSize="14" Margin="0,8,0,24" />
                    <TextBlock Text="路径" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SelectedInstance.DirectoryPath}" TextWrapping="Wrap" Margin="0,5,0,18" />
                    <TextBlock Text="版本类型" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SelectedInstance.Type}" Margin="0,5,0,18" />
                    <TextBlock Text="Java 要求" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SelectedInstance.JavaMajorHint, StringFormat=Java {0}+, TargetNullValue=由版本元数据决定}"
                               Margin="0,5,0,24" />
                    <Button Content="启动此实例" Style="{StaticResource PrimaryButton}" Height="48"
                            Command="{Binding LaunchCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
