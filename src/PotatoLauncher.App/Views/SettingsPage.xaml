<UserControl x:Class="PotatoLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,30">
            <Grid Margin="6,0,6,18">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="外观、Java、下载与微软登录。" Style="{StaticResource MutedText}" FontSize="14" />
                </StackPanel>
                <Button Content="保存全部设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Command="{Binding SaveSettingsCommand}" />
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="主题模式" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding Settings.ThemeMode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="种子色" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.SeedColor, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="减少动画" IsChecked="{Binding Settings.ReducedMotion}"
                                  VerticalAlignment="Bottom" Margin="18,0,0,10" />
                        <Button Grid.Column="3" Content="应用主题" Style="{StaticResource TonalButton}"
                                VerticalAlignment="Bottom" Command="{Binding ApplyThemeCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="游戏与 Java" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Minecraft 目录" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.MinecraftDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="选择目录" Style="{StaticResource OutlineButton}"
                                Margin="10,24,0,0" Command="{Binding ChooseMinecraftFolderCommand}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Java 运行时" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJava}"
                                      DisplayMemberPath="VersionText" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="内存 (MB)" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.MemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="窗口宽度" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                            <TextBlock Text="窗口高度" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="新实例使用版本隔离" IsChecked="{Binding Settings.VersionIsolation}" Margin="0,14,0,0" />
                    <TextBlock Text="额外 JVM 参数" Style="{StaticResource MutedText}" Margin="0,14,0,7" />
                    <TextBox Text="{Binding Settings.ExtraJvmArguments, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="重新探测 Java" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Command="{Binding RefreshJavaCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="并发数 (4–32)" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.DownloadConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="镜像地址" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding Settings.MirrorBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="官方源失败时会暂停下载并询问是否改用镜像，不会静默切换。"
                               Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Microsoft 登录" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Azure 公共客户端；无需客户端密钥。默认回调为 http://localhost:53682/callback。"
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <TextBlock Text="Application (client) ID" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                    <TextBox Text="{Binding Settings.MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="回调 URI" Style="{StaticResource MutedText}" Margin="0,14,0,7" />
                    <TextBox Text="{Binding Settings.MicrosoftRedirectUri, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
