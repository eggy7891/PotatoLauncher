<UserControl x:Class="PotatoLauncher.App.Views.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageContent}">
    <Grid Margin="16,24,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="6,0,6,18">
            <StackPanel>
                <TextBlock Text="任务与日志" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="打开日志目录" Style="{StaticResource OutlineButton}" Command="{Binding OpenLogFolderCommand}" />
                <Button Content="数据目录" Style="{StaticResource TonalButton}" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,6,12">
                    <TextBlock Text="启动器与游戏输出" FontSize="16" FontWeight="SemiBold" />
                    <Button Content="清空显示" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                            Command="{Binding ClearVisibleLogCommand}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="{DynamicResource SurfaceBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
